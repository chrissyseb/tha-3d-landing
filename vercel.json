{
 "cleanUrls": false,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "X-Frame-Options",
     "value": "DENY"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(self), geolocation=()"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  },
  {
   "source": "/carry.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/api/config",
   "destination": "/api/x?r=config"
  },
  {
   "source": "/api/google",
   "destination": "/api/x?r=google"
  },
  {
   "source": "/api/redeem",
   "destination": "/api/x?r=redeem"
  },
  {
   "source": "/account",
   "destination": "/account.html"
  },
  {
   "source": "/lists",
   "destination": "/lists.html"
  },
  {
   "source": "/supporters",
   "destination": "/api/supporters"
  },
  {
   "source": "/teachers",
   "destination": "/teachers.html"
  }
 ],
 "redirects": [
  {
   "source": "/:path((?!carry\\.html$).*)",
   "has": [
    {
     "type": "host",
     "value": "vocab-obby.vercel.app"
    }
   ],
   "destination": "https://vocabobby.vercel.app/:path?from=old",
   "statusCode": 301
  }
 ]
}